# ==============================================================
# Variables de Entorno - Organizador de la Predicación Congregacional
# ==============================================================

# Cadena de conexión principal (Neon Console / PostgreSQL)
DATABASE_URL="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require"

# Parámetros individuales (opcional como fallback)
SQL_HOST="[host]"
SQL_USER="[user]"
SQL_PASSWORD="[password]"
SQL_DB_NAME="[dbname]"
SQL_ADMIN_USER="[user]"
SQL_ADMIN_PASSWORD="[password]"

# URL pública de la aplicación
APP_URL="https://organizacion-de-predicacion.vercel.app"

# Credenciales de Firebase Admin para eliminar cuentas autenticadas vinculadas.
# En Google Cloud puede omitirse si Application Default Credentials están disponibles.
GOOGLE_APPLICATION_CREDENTIALS="C:\\ruta\\privada\\firebase-service-account.json"
